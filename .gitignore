# ==========================================
# GitHub / GitGuardian Security & Clean Repo
# Custom .gitignore for Django & Python Projects
# ==========================================

# 1. Environment & Secret Keys (CRITICAL SECURITY)
.env
.env.*
!.env.example
secrets.json
*.pem
*.key
*.cert

# 2. Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 3. Virtual Environments
venv/
v-env/
env/
envs/
.venv/
ENV/

# 4. Django Specifics
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
PROJECT_DUMP.txt

# 5. IDE & System Files
.vscode/
.idea/
.DS_Store
Thumbs.db